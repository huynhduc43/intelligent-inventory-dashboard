# Copy to apps/api/.env for local runs (`pnpm dev`, `pnpm db:migrate`). See docs/environment-setup.md.
DATABASE_URL=postgres://inventory:inventory@localhost:5432/inventory
# At least 32 characters. Generate one with: openssl rand -base64 48
JWT_SECRET=change-me-to-at-least-32-random-characters
# Optional, defaults shown.
# PORT=3000
# LOG_LEVEL=info
# DB_STATEMENT_TIMEOUT_MS=5000
# JWT_TTL_S=3600
