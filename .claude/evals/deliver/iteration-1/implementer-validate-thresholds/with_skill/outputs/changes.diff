@@ -14,3 +14,23 @@ export const tierOf = (days: number, t: Thresholds): Tier =>
 // Fixed buckets, independent of the thresholds (D10).
 export const bucketOf = (days: number): AgeBucket =>
   days <= 30 ? '0-30' : days <= 60 ? '31-60' : days <= 90 ? '61-90' : '90+';
+
+export type ThresholdsCheck =
+  { ok: true } | { ok: false; code: 'INVALID_THRESHOLDS'; reason: string };
+
+// Mirrors `dealership_thresholds_chk` (1 ≤ watch < aging ≤ 3650) so bad input is a 400, not a DB error (D3).
+export const validateThresholds = (t: Thresholds): ThresholdsCheck => {
+  const reason =
+    !Number.isInteger(t.watch) || !Number.isInteger(t.aging)
+      ? 'watch and aging must be whole numbers of days'
+      : t.watch < 1
+        ? 'watch must be at least 1'
+        : t.watch >= t.aging
+          ? 'watch must be less than aging'
+          : t.aging > 3650
+            ? 'aging must be at most 3650'
+            : undefined;
+  return reason === undefined
+    ? { ok: true }
+    : { ok: false, code: 'INVALID_THRESHOLDS', reason };
+};
