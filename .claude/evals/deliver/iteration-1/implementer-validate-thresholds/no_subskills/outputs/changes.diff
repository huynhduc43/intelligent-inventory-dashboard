diff --git a/apps/api/src/modules/inventory/domain/aging-policy.ts b/apps/api/src/modules/inventory/domain/aging-policy.ts
index b838b69..da94900 100644
--- a/apps/api/src/modules/inventory/domain/aging-policy.ts
+++ b/apps/api/src/modules/inventory/domain/aging-policy.ts
@@ -14,3 +14,25 @@ export const tierOf = (days: number, t: Thresholds): Tier =>
 // Fixed buckets, independent of the thresholds (D10).
 export const bucketOf = (days: number): AgeBucket =>
   days <= 30 ? '0-30' : days <= 60 ? '31-60' : days <= 90 ? '61-90' : '90+';
+
+export type ThresholdsCheck =
+  { ok: true } | { ok: false; code: 'INVALID_THRESHOLDS'; reason: string };
+
+// Mirrors `dealership_thresholds_chk`, so a bad request fails before Postgres (D3).
+export const validateThresholds = ({
+  watch,
+  aging,
+}: Thresholds): ThresholdsCheck => {
+  const reason = !(Number.isInteger(watch) && Number.isInteger(aging))
+    ? 'watch and aging must be integers'
+    : watch < 1
+      ? 'watch must be at least 1'
+      : watch >= aging
+        ? 'watch must be less than aging'
+        : aging > 3650
+          ? 'aging must be at most 3650'
+          : undefined;
+  return reason === undefined
+    ? { ok: true }
+    : { ok: false, code: 'INVALID_THRESHOLDS', reason };
+};
