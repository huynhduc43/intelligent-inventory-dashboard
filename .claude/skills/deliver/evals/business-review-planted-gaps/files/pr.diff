@@ -0,0 +1,10 @@
+import { IsIn, IsOptional, IsString, MaxLength } from 'class-validator';
+import { ACTION_TYPES } from './action-type.js';
+
+export class LogActionDto {
+  @IsIn(ACTION_TYPES) actionType!: string;
+  @IsOptional() @IsString() @MaxLength(Number(process.env.ACTION_NOTE_MAX_LENGTH)) note?: string;
+}
