+import { ConflictException, Inject, Injectable, NotFoundException } from '@nestjs/common';
+import { and, desc, eq, sql } from 'drizzle-orm';
+import { differenceInCalendarDays } from 'date-fns';
+import { formatInTimeZone } from 'date-fns-tz';
+import { Clock } from '../../shared/clock.js';
+import { DB, type Db } from '../../shared/db.js';
+import { vehicle, vehicleAction } from '../../shared/schema.js';
+import type { DealershipContext } from '../auth/dealership-context.js';
+
+@Injectable()
+export class ActionsService {
+  constructor(
+    @Inject(DB) private readonly db: Db,
+    private readonly clock: Clock,
+  ) {}
+
+  async list(ctx: DealershipContext, vehicleId: string) {
+    return this.db
+      .select()
+      .from(vehicleAction)
+      .where(eq(vehicleAction.vehicleId, vehicleId))
+      .orderBy(desc(vehicleAction.id));
+  }
+
+  async log(ctx: DealershipContext, vehicleId: string, input: { actionType: string; note?: string }) {
+    return this.db.transaction(async (tx) => {
+      const inserted = await tx.execute(sql`
+        INSERT INTO vehicle_action (dealership_id, vehicle_id, action_type, note, created_by, created_at)
+        SELECT v.dealership_id, v.id, ${input.actionType}, ${input.note ?? null}, ${ctx.userId}, ${this.clock.now()}
+        FROM vehicle v
+        WHERE v.id = ${vehicleId} AND v.dealership_id = ${ctx.dealershipId} AND v.status = 'IN_STOCK'
+        RETURNING *`);
+      const row = inserted.rows[0];
+      if (!row) {
+        const [existing] = await this.db
+          .select({ status: vehicle.status })
+          .from(vehicle)
+          .where(and(eq(vehicle.id, vehicleId), eq(vehicle.dealershipId, ctx.dealershipId)));
+        if (!existing) throw new NotFoundException();
+        throw new ConflictException({ code: 'VEHICLE_NOT_IN_STOCK' });
+      }
+      const [v] = await tx
+        .select({ stockedOn: vehicle.stockedOn })
+        .from(vehicle)
+        .where(eq(vehicle.id, vehicleId));
+      const today = formatInTimeZone(this.clock.now(), ctx.timezone, 'yyyy-MM-dd');
+      const daysInStock = differenceInCalendarDays(new Date(today), new Date(v!.stockedOn));
+      return { ...row, daysInStock };
+    });
+  }
+}
